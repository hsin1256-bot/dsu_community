# ── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# 서버 전용 (공지·학사일정 저장). 절대 NEXT_PUBLIC_ 을 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_sb_secret_key

# ── Gemini (공지 요약, 서버 전용) ─────────────────────────
# 없으면 요약 없이 원문만 저장되고 ai_status=failed 로 남아 다음 동기화 때 재시도합니다.
GEMINI_API_KEY=your_gemini_api_key

# ── 예약 동기화 토큰 (/api/sync 호출용) ───────────────────
# 없으면 /api/sync 는 항상 401 입니다. GitHub Actions Secret 에도 같은 값을 넣으세요.
CRON_SECRET=your_long_random_string
